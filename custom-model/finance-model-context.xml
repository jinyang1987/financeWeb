<?xml version='1.0' encoding='UTF-8'?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
          http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!--
        Register the finance custom content model.
        The parent="dictionaryModelBootstrap" ensures it is loaded
        during Alfresco dictionary bootstrap phase.
    -->
    <bean id="finance.model.dictionaryBootstrap" parent="dictionaryModelBootstrap" depends-on="dictionaryBootstrap">
        <property name="models">
            <list>
                <value>alfresco/extension/finance-model.xml</value>
            </list>
        </property>
    </bean>
</beans>
